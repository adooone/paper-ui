{
  "permissions": {
    "allow": [
      "Edit(src/**)",
      "Write(src/**)",
      "Edit(scripts/**)",
      "Write(scripts/**)",
      "Edit(papercamp/**)",
      "Write(papercamp/**)",
      "Edit(*.json)",
      "Write(*.json)",
      "Edit(*.ts)",
      "Write(*.ts)",
      "Edit(*.md)",
      "Write(*.md)",
      "Edit(*.config.ts)",
      "Write(*.config.ts)",
      "Bash(pnpm run *)",
      "Bash(pnpm test*)",
      "Bash(pnpm build*)",
      "Bash(npx biome check*)",
      "Bash(node scripts/*)",
      "Bash(node --experimental-strip-types scripts/*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "paper-camp session-focus"
          }
        ]
      }
    ]
  }
}
